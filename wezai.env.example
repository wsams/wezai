# Copy to ~/.config/wezterm/wezai.env (or $XDG_CONFIG_HOME/wezterm/wezai.env).
# GUI / Flatpak WezTerm often does not see variables from .bashrc — this file does.
# Lines starting with # are ignored. Do not commit real API keys.

# Provider: http (OpenAI-compatible, including Ollama) | google | ollama | local
# WEZAI_TYPE=http

# Ollama OpenAI-compatible endpoint (plugin default). Cloud example:
# WEZAI_API_URL=https://api.openai.com/v1/chat/completions
# WEZAI_API_URL=http://127.0.0.1:11434/v1/chat/completions

# Optional. Falls back to OPENAI_API_KEY or GEMINI_API_KEY if unset.
# WEZAI_API_KEY=

# Instruct model that can emit JSON (Ask / @@ edit). Prefer this over "thinking" GGUFs.
# WEZAI_MODEL=llama3.2
# WEZAI_MODELS=llama3.2,qwen2.5:14b

# curl --max-time seconds. Raise for cold local GGUFs (300–600).
# WEZAI_TIMEOUT=300

# WEZAI_OLLAMA_PATH=/usr/bin/ollama
# WEZAI_LMS_PATH=/usr/local/bin/lms

# WEZAI_KUBE_NS=default

# Seed @weather until you run @weather:zip (saved under ~/.local/share/wezai/weather.json).
# WEZAI_WEATHER_ZIP=90210
# WEZAI_WEATHER_COUNTRY=US
# WEZAI_WEATHER_UNITS=auto
